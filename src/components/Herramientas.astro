---
// Se reutiliza en Sobre mí (paso 9)
const inventario = [
  { categoria: 'Diseño', items: ['Figma', 'Photoshop', 'Illustrator', 'After Effects'] },
  { categoria: 'Frontend', items: ['HTML', 'CSS', 'JavaScript', 'TypeScript'] },
  { categoria: 'Backend', items: ['Node.js', 'Express'] },
  { categoria: 'Videojuegos', items: ['C#', 'Unity'] },
  { categoria: 'Flujo de trabajo', items: ['Git'] },
];
---

<section class="herramientas" aria-labelledby="herramientas-titulo" data-xp-id="herramientas">
  <div class="container">
    <p class="antetitulo" data-entrada>Inventario</p>
    <h2 id="herramientas-titulo" class="titulo-seccion" data-entrada>Herramientas</h2>
    <dl class="m-0" data-entrada="grupo">
      {inventario.map(({ categoria, items }) => (
        <div class="fila">
          <dt>{categoria}</dt>
          <dd class="m-0">
            <ul class="list-unstyled d-flex flex-wrap gap-2 m-0">
              {items.map((item) => <li class="item">{item}</li>)}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style lang="scss">
  .herramientas {
    padding-block: 5rem;
  }

  .fila {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.25rem;
    border-top: 2px solid var(--tinta);

    @media (min-width: 768px) {
      grid-template-columns: 14rem 1fr;
      align-items: center;
    }
  }

  dt {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
  }

  .item {
    padding: 0.375rem 0.875rem;
    background: var(--tinta);
    color: var(--lima);
    font-weight: 700;
    border-radius: 0.25rem;
  }
</style>
