---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
const total = String(proyectos.length + 1).padStart(2, '0');
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<section id="proyectos" class="carrusel" aria-labelledby="proyectos-titulo">
  <div class="container d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div>
      <p class="antetitulo" data-entrada>Selecciona un nivel</p>
      <h2 id="proyectos-titulo" class="titulo-seccion m-0" data-entrada>Proyectos</h2>
    </div>
    <!-- Ocultos sin JS: los muestra carrusel.ts -->
    <div class="controles d-flex gap-2" hidden>
      <button type="button" data-paso="-1" aria-label="Proyecto anterior">◀</button>
      <button type="button" data-paso="1" aria-label="Proyecto siguiente">▶</button>
    </div>
  </div>
  <p class="visually-hidden" aria-live="polite" data-anuncio></p>

  <!-- Base sin JS: scroll horizontal nativo con snap. carrusel.ts añade botones, color y, en escritorio, el scroll fijado. -->
  <div class="pista" role="region" aria-label="Proyectos, desliza o usa las flechas" tabindex="0">
    <ol class="list-unstyled m-0">
      {proyectos.map(({ id, data }, i) => (
        <li class="slide" data-color={data.color} data-titulo={data.titulo}>
          <article class="tarjeta" style={`--color: var(--${data.color})`}>
            <div class="portada" transition:name={`portada-${id}`}>
              <Image
                src={data.portada}
                alt={data.portadaAlt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 860px) 46rem, 85vw"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </div>
            <div class="cuerpo">
              <p class="contador" aria-hidden="true">{num(i)}/{total}</p>
              <h3><a href={`/proyectos/${id}`}>{data.titulo}</a></h3>
              <p class="resumen">{data.resumen}</p>
              <p class="tipo">{data.tipo}</p>
            </div>
          </article>
        </li>
      ))}
      <li class="slide" data-color="fondo" data-titulo="¿Tu proyecto aquí?">
        <article class="tarjeta tarjeta-cta">
          <div class="cuerpo">
            <p class="contador" aria-hidden="true">{total}/{total}</p>
            <h3><a href="#contacto">¿Tu proyecto aquí?</a></h3>
            <p class="resumen">El siguiente nivel puede ser el tuyo. Trabajemos juntos.</p>
          </div>
        </article>
      </li>
    </ol>
  </div>
</section>

<style lang="scss">
  .carrusel {
    padding-block: 5rem;
    // Alinea el inicio de la pista con el .container de Bootstrap (máx. 1320px)
    --margen: max(0.75rem, (100% - 1320px) / 2 + 0.75rem);
    // carrusel.ts cambia --fondo-carrusel al color del proyecto activo
    background-color: var(--fondo-carrusel, var(--fondo));
    transition: background-color 0.4s;
  }

  .controles button {
    width: 3rem;
    aspect-ratio: 1;
    background: var(--tinta);
    color: var(--lima);
    border: 2px solid var(--tinta);
    border-radius: 0.25rem;
    font-size: 1.125rem;

    // Solo con mouse: en pantallas táctiles el hover se queda "pegado" tras tocar
    @media (hover: hover) {
      &:hover {
        background: var(--lima);
        color: var(--tinta);
      }
    }
  }

  // Solo en modo fijado (escritorio y sin reduced-motion): la tarjeta activa se endereza y crece
  .carrusel.animado .slide {
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .carrusel.animado .slide:not(.activa) {
    transform: scale(0.88) rotate(-3deg);
  }

  .pista {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margen);
    padding-block: 0.5rem 1.5rem;
    scrollbar-color: var(--tinta) var(--lavanda-suave);

    ol {
      position: relative; // referencia para offsetLeft de las slides
      display: flex;
      gap: 1.5rem;
      width: max-content;
      padding-inline: var(--margen);
    }
  }

  .slide {
    width: min(85vw, 46rem);
    scroll-snap-align: start;
  }

  .tarjeta {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--color, var(--lavanda-suave));
    border: 2px solid var(--tinta);
    border-radius: 0.5rem;
    overflow: hidden;

    &:focus-within {
      outline: 3px solid var(--tinta);
      outline-offset: 3px;
    }
  }

  .portada {
    border-bottom: 2px solid var(--tinta);

    :global(img) {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }
  }

  .cuerpo {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .contador {
    font-family: var(--font-display);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  h3 {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    text-transform: uppercase;
    margin-bottom: 0.75rem;

    a {
      text-decoration: none;

      // Toda la tarjeta es clicable; el foco se muestra en la tarjeta (:focus-within)
      &::after {
        content: '';
        position: absolute;
        inset: 0;
      }

      &:focus-visible {
        outline: none;
      }
    }
  }

  .resumen {
    max-width: 36rem;
  }

  .tipo {
    display: inline-block;
    margin: 0;
    padding: 0.25rem 0.75rem;
    background: var(--tinta);
    color: var(--lima);
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 0.25rem;
  }

  .tarjeta-cta {
    justify-content: center;
    background: var(--tinta);
    color: var(--fondo);
    min-height: 20rem;

    h3 a {
      color: var(--lima);
    }
  }
</style>
